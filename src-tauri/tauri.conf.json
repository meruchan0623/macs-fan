{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macs Fan",
  "version": "0.16.0",
  "identifier": "local.macsfan.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Macs Fan",
        "width": 560,
        "height": 440,
        "minWidth": 460,
        "minHeight": 340,
        "backgroundColor": "#f6f5f1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Utilities",
    "shortDescription": "本地风扇与温度监测",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
